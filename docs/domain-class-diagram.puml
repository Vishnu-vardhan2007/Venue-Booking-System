@startuml

class Customer {
    - userId : int
    - name : String
    - email : String

    + searchVenue() : List<Venue>
    + viewVenueDetails() : Venue
}

class Venue {
    - venueId : int
    - name : String
    - location : String
    - type : String
    - capacity : int
    - price : double

    + getDetails() : String
    + matchesCriteria() : boolean
}

