@startuml
left to right direction

skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #FFF2CC
    BorderColor #C9A227
    ArrowColor black
}

actor Customer
actor "Venue Owner" as Owner
actor Admin

rectangle "VENUE BOOKING SYSTEM" {

    '================ CUSTOMER =================
    usecase "Register/Login" as C1
    usecase "Search Venues" as C2
    usecase "Filter Venues" as C3
    usecase "View Venue Details" as C4
    usecase "View Facilities\n&Pricing" as C5
    usecase "Check Availability" as C6
    usecase "Contact Venue\nOwner" as C7
    usecase "View Owner\nDetails" as C8

    usecase "Select Date &\nTime" as C9
    usecase "Confirm Booking" as C10
    usecase "Booking History" as C11
    usecase "Booking\nNotifications" as C12

    '================ VENUE OWNER =================
    usecase "Register/Login" as O1
    usecase "Add/Manage\nVenues" as O2
    usecase "View Bookings" as O3
    usecase "Update Availability" as O4
    usecase "Update Booking\nStatus" as O5

    '================ ADMIN =================
    usecase "Manage Users" as A1
    usecase "Approve/Reject\nVenues" as A2
    usecase "Manage all\nBookings" as A3
}

'================ CUSTOMER ASSOCIATIONS =================
Customer --> C1
Customer --> C2
Customer --> C4
Customer --> C6
Customer --> C7
Customer --> C9
Customer --> C10
Customer --> C11
Customer --> C12

C2 ..> C3 : <<include>>
C4 ..> C5 : <<include>>
C7 ..> C8 : <<include>>

C10 ..> C9 : <<include>>
C10 ..> C12 : <<include>>

C11 ..> C10 : <<extend>>

'================ VENUE OWNER ASSOCIATIONS =================
Owner --> O1
Owner --> O2
Owner --> O3
Owner --> O4
Owner --> O5

O5 ..> C12 : <<include>>

'================ ADMIN ASSOCIATIONS =================
Admin --> A1
Admin --> A2
Admin --> A3

@enduml
    usecase "Add/Manage Venues" as UC12
    usecase "View Bookings" as UC13
    usecase "Update Availability" as UC14
    usecase "Update Booking Status" as UC15
  }

  package "Admin Functions" {
    usecase "Manage Users" as UC16
    usecase "Approve/Reject Venues" as UC17
    usecase "Manage all Bookings" as UC18
  }
}

' Customer associations
Customer --> UC1
Customer --> UC2
Customer --> UC4
Customer --> UC6
Customer --> UC7

' Venue Owner associations
VenueOwner --> UC11
VenueOwner --> UC12
VenueOwner --> UC13
VenueOwner --> UC14
VenueOwner --> UC15

' Admin associations
Admin --> UC16
Admin --> UC17
Admin --> UC18

' Include relationships
UC2 .> UC3 : <<include>>
UC4 .> UC5 : <<include>>
UC7 .> UC8 : <<include>>

' Sequential flow from your Mermaid diagram
UC8 --> UC9
UC9 --> UC10

' Extend relationship from Mermaid
UC7 .> UC10 : <<extend>>

@enduml
