@startuml
left to right direction

skinparam packageStyle rectangle

actor Customer
actor "Venue Owner" as VenueOwner
actor Admin

rectangle "Venue Booking System" {

  package "Customer Functions" {
    usecase "Register/Login" as UC1
    usecase "Search Venues" as UC2
    usecase "Filter Venues" as UC3
    usecase "View Venue Details" as UC4
    usecase "View Facilities & Pricing" as UC5
    usecase "Check Availability" as UC6
    usecase "Contact Venue Owner" as UC7
    usecase "View Owner Details" as UC8
    usecase "Select Date & Time" as UC9
    usecase "Confirm Booking" as UC10
  }

  package "Owner Functions" {
    usecase "Register/Login" as UC11
    usecase "Add/Manage Venues" as UC12
    usecase "View Bookings" as UC13
    usecase "Update Availability" as UC14
    usecase "Update Booking Status" as UC15
  }

  package "Admin Functions" {
    usecase "Manage Users" as UC16
    usecase "Approve/Reject Venues" as UC17
    usecase "Manage all Bookings" as UC18
  }
}

' Customer associations
Customer --> UC1
Customer --> UC2
Customer --> UC4
Customer --> UC6
Customer --> UC7

' Venue Owner associations
VenueOwner --> UC11
VenueOwner --> UC12
VenueOwner --> UC13
VenueOwner --> UC14
VenueOwner --> UC15

' Admin associations
Admin --> UC16
Admin --> UC17
Admin --> UC18

' Include relationships
UC2 .> UC3 : <<include>>
UC4 .> UC5 : <<include>>
UC7 .> UC8 : <<include>>

' Sequential flow from your Mermaid diagram
UC8 --> UC9
UC9 --> UC10

' Extend relationship from Mermaid
UC7 .> UC10 : <<extend>>

@enduml
